# Copy this file to .env and fill in your actual values

# Supabase Configuration
SUPABASE_PROJECT_ID=your_project_id
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Database Connection String
POSTGRES_URL=postgresql://postgres:your_password@your-project.supabase.co:5432/postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password

# WhatsApp API
WHATSAPP_ACCOUNT_SID=your_twilio_account_sid
WHATSAPP_AUTH_TOKEN=your_twilio_auth_token
WHATSAPP_PHONE_NUMBER=whatsapp:+1234567890

# JWT Configuration
JWT_SECRET=your-secret-key-min-32-characters-long
JWT_ISSUER=VillaManager
JWT_AUDIENCE=VillaManagerApp

# Application Settings
ENVIRONMENT=Development
LOG_LEVEL=Information

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000

# API Settings
API_PORT=7001
